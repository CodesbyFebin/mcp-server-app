# MCPserver.in + app.mcpserver.in Environment Configuration
# Copy to .env and adjust for your deployment environment

# ==========================================
# Core Application
# ==========================================
NODE_ENV=production
PORT=3000

# ==========================================
# Authentication (HS256 JWT)
# ==========================================
SECRET_KEY=change-this-to-a-strong-random-value
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15

# ==========================================
# Database (PostgreSQL + Drizzle)
# ==========================================
DATABASE_URL=postgres://mcp_user:mcp_pass@postgres:5432/mcp_servers

# ==========================================
# Redis (Caching, Session)
# ==========================================
REDIS_URL=redis://redis:6379

# ==========================================
# LLM Gateway
# ==========================================
GEMINI_API_KEY=your-gemini-api-key
NVIDIA_API_KEY=your-nvidia-api-key
CLOUDFLARE_API_KEY=your-cloudflare-api-key
OLLAMA_BASE_URL=http://ollama:11434
VLLM_BASE_URL=http://vllm:8000

# ==========================================
# Services
# ==========================================
MCP_SERVER_URL=http://mcp-server:8000
GATEWAY_URL=http://gateway:8002
API_URL=http://api:8001

# ==========================================
# External Services
# ==========================================
# GST validation (optional external validator)
GST_VALIDATOR_URL=http://host.docker.internal:8000/tools/gst

# UPI validation (optional external validator)
UPI_VALIDATOR_URL=http://host.docker.internal:8000/tools/payments

# ==========================================
# Deployment
# ==========================================
# Vercel/production settings
VERCEL_DEPLOYMENT=local
# Production domain
PUBLIC_DOMAIN=https://www.mcpserver.in
APP_PUBLIC_DOMAIN=https://app.mcpserver.in

# ==========================================
# SEO/AEO/GEO
# ==========================================
SITE_TITLE=MCPserver.in
SITE_DESCRIPTION=Model Context Protocol Server Directory and Knowledge Graph
SITE_KEYWORDS=mcp, server, directory, registry, ai, agents, language models